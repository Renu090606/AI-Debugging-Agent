# Backend Environment Variables
# Copy this file to .env and fill in your actual keys

# Groq API (Primary LLM) — get from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (Fallback LLM) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (local dev default)
FRONTEND_URL=http://localhost:5173
